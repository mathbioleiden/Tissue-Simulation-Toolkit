ymmsl_version: v0.1
model:
  name: adhesions
  components:
    make_ecm:
      ports:
        o_f:
        - ecm_out
      implementation: make_ecm
    equilibrate_ecm:
      ports:
        f_init:
        - ecm_in
        o_f:
        - ecm_out
      implementation: simulate_ecm
    stretch_ecm:
      ports:
        f_init:
        - ecm_in
        o_f:
        - ecm_out
      implementation: stretch_ecm
    cellular_potts:
      ports:
        o_i:
        - cell_ecm_interactions_out
        - state_out
        s:
        - ecm_boundary_state_in
      implementation: tst_adhesions
    simulate_ecm:
      ports:
        f_init:
        - ecm_in
        o_i:
        - ecm_boundary_state_out
        - state_out
        s:
        - cell_ecm_interactions_in
        o_f:
        - ecm_out
      implementation: simulate_ecm
    state_dumper:
      ports:
        f_init:
        - cpm_state_in
        - ecm_state_in
      implementation: state_dumper
  conduits:
    make_ecm.ecm_out: stretch_ecm.ecm_in
    stretch_ecm.ecm_out: equilibrate_ecm.ecm_in
    equilibrate_ecm.ecm_out: simulate_ecm.ecm_in
    cellular_potts.cell_ecm_interactions_out: simulate_ecm.cell_ecm_interactions_in
    simulate_ecm.ecm_boundary_state_out: cellular_potts.ecm_boundary_state_in
    cellular_potts.state_out: state_dumper.cpm_state_in
    simulate_ecm.state_out: state_dumper.ecm_state_in
settings:
  muscle_local_log_level: DEBUG
  sizex: 400
  sizey: 400
  box_size_x: 400
  box_size_y: 400
  Lx: 200.0
  Ly: 200.0
  mcs: 5000
  rseed: -1
  make_ecm.fixed_boundary: true
  make_ecm.bottom_fixed: false
  make_ecm.top_fixed: true
  make_ecm.left_side_fixed: false
  make_ecm.right_side_fixed: false
  contour_length: 50.0
  make_ecm.strands: 1
  make_ecm.beads: 9
  make_ecm.spring_r0: 6.25
  make_ecm.spring_k: 50.0
  make_ecm.crosslink_k: 50.0
  make_ecm.helix_angle: 0.0
  make_ecm.bend_t0: 3.14159265358979312
  make_ecm.bend_k: 50.0
  make_ecm.num_init_crosslinks: 48000
  make_ecm.crosslink_max_r: 3.0
  make_ecm.crosslink_quant_step: 0.3
  make_ecm.crosslink_bin_size: 0.333333333333333315
  make_ecm.network_seed: 0
  make_ecm.network_type: directed
  make_ecm.ISV_laminin_amount: 0
  make_ecm.direction_angle: 1.6
  make_ecm.direction_spread: 0.0
  make_ecm.ISV_xaxis_spread: 20.0
  make_ecm.laminin_size: 10.0
  md_use_gpu: false
  md_seed: 12345678
  overdamped: true
  md_kT: 0.001
  viscosity: 10.0
  md_dt: 0.01
  stretch_ecm.number_of_stretch_steps: 0
  stretch_ecm.md_its: 1
  equilibrate_ecm.mcs: 1
  equilibrate_ecm.md_its: 1
  simulate_ecm.md_its: 200
  cellular_potts.storage_stride: 1
  cellular_potts.graphics: true
  cellular_potts.store: false
  cellular_potts.datadir: ./pictures/
  cellular_potts.colortable: /home/koen/TST-adh/data/default.ctb
  cellular_potts.T: 50
  cellular_potts.target_area: 800
  cellular_potts.target_length: 40
  cellular_potts.lambda: 1.0
  cellular_potts.lambda_somite: 50.0
  cellular_potts.somite_antitaxis: 10000
  cellular_potts.lambda2: 7.0
  cellular_potts.lambda_spread: 0.0
  cellular_potts.Jtable: /home/koen/20250513/run_all_fa_less_contract/noecm/J.dat
  cellular_potts.non_intergrin_binding_area: 800
  cellular_potts.conn_diss: 50000
  cellular_potts.vecadherinknockout: true
  cellular_potts.chemotaxis: 1000
  cellular_potts.extensiononly: false
  cellular_potts.border_energy: 50
  cellular_potts.neighbours: 2
  cellular_potts.periodic_boundaries: false
  cellular_potts.n_chem: 2
  cellular_potts.diff_coeff: [1.0e-12, 1.0e-13]
  cellular_potts.decay_rate: [5.0e-14, 1.8e-4]
  cellular_potts.secr_rate: [1.0, 1.8e-4]
  cellular_potts.single_cell_origin: [100.0, 100.0]
  cellular_potts.saturation: 0.
  cellular_potts.dt: 2.
  cellular_potts.dx: 2e-6
  cellular_potts.pde_its: 10
  cellular_potts.useopencl: false
  cellular_potts.n_init_cells: 100
  cellular_potts.size_init_cells: 800
  cellular_potts.divisions: 0
  cellular_potts.subfield: 1
  cellular_potts.relaxation: 0
  cellular_potts.number_of_somites: 3
  cellular_potts.somite_somite_distance: 64
  cellular_potts.distance_from_bottom_not_to_update: 3
  cellular_potts.somite_hight: 150
  cellular_potts.adhesions_enabled: true
  cellular_potts.num_initial_adhesions: 0
  cellular_potts.adhesion_extension_mechanism: lazy
  cellular_potts.adhesion_yielding: true
  cellular_potts.adhesion_maximum_contractile_percentage: 0.0
  cellular_potts.adhesion_integrin_N0: 50
  cellular_potts.adhesion_yielding_lambda: 800
  cellular_potts.adhesion_yielding_Nh: 70
  cellular_potts.adhesion_contraction_force: 10
  cellular_potts.ns_Nt: 390
  cellular_potts.ns_phi_s: 4.02
  cellular_potts.ns_phi_c: 7.76
  cellular_potts.ns_d0: 0.01
  cellular_potts.ns_gamma: 1
  cellular_potts.ns_dt: 0.0001
  cellular_potts.ns_T: 0.1
  cellular_potts.ns_f_star: 1
  cellular_potts.d_FA: 0
  cellular_potts.FA_creation_threashold: 0.75
  cellular_potts.lambda_Act: 0.0
  cellular_potts.max_Act: 1
  cellular_potts.myosin_intergration_time: 1.0
  cellular_potts.myosin_decay_rate: 0.0
  cellular_potts.myosin_creation_rate: 10.0
  cellular_potts.myosin_intergration_timestep: 0.001
  cellular_potts.division_algo: time
  cellular_potts.division_rate_erlang_k: 4
  cellular_potts.division_rate_erlang_lambda: 0.0
  cellular_potts.division_area: 400
  cellular_potts.division_rate_tipcell: 0.0
  cellular_potts.division_rate_stalkcell: 0.0
  cellular_potts.connectivity_check_durand: false
  cellular_potts.vegf_bias: false
  cellular_potts.polarity_bias: false
  cellular_potts.cell_polarity_history: 100
  cellular_potts.polarity_kernel: exp
  cellular_potts.polarity_kernel_exp_rate: 0.001
  cellular_potts.only_tipcell_adh: true
  cellular_potts.relaxation_time: 10
  graphics: true
  state_output_interval: 10
  cellular_potts.isv_init: false
  it: 3
implementations:
  init_ecm:
    virtual_env: /home/koen/TST-adh/venv
    executable: init_ecm
  make_ecm:
    virtual_env: /home/koen/TST-adh/venv
    executable: make_ecm
  tst_adhesions:
    env:
      +LD_LIBRARY_PATH: :/home/koen/TST-adh/lib/muscle3/muscle3/lib
    executable: /home/koen/TST-adh/bin/ISV_multiple
  tst_adhesions_snellius:
    modules:
    - '2022'
    - Qt5/5.15.5-GCCcore-11.3.0
    env:
      +LD_LIBRARY_PATH: :/home/koen/TST-adh/lib/muscle3/muscle3/lib
    executable: /home/koen/TST-adh/bin/adhesions
  tst_adhesions_debug:
    env:
      +LD_LIBRARY_PATH: :/home/koen/TST-adh/lib/muscle3/muscle3/lib
    executable: /usr/bin/lldb
    args:
    - -s
    - /home/koen/TST-adh/storage_local/20241204/debug_script.lldb
    - --
    - /home/koen/TST-adh/bin/ISV_dynamic_polarity
  simulate_ecm:
    virtual_env: /home/koen/TST-adh/venv
    executable: simulate_ecm
  simulate_ecm_mpi:
    virtual_env: /home/koen/TST-adh/venv
    execution_model: openmpi
    executable: simulate_ecm
  simulate_ecm_snellius:
    modules:
    - '2022'
    - OpenMPI/4.1.4-GCC-11.3.0
    - Python/3.10.4-GCCcore-11.3.0
    - CUDA/11.8.0
    virtual_env: /home/koen/TST-adh/venv
    execution_model: openmpi
    executable: simulate_ecm
  simulate_ecm_profile:
    virtual_env: /home/koen/TST-adh/venv
    executable: python3
    args:
    - -m
    - cProfile
    - -o
    - cProfile.data
    - -m
    - ecm.simulate_ecm
  state_dumper:
    virtual_env: TST-HOOMD-MUSCLE3/venv
    executable: state_dumper
  stretch_ecm:
    virtual_env: /home/koen/TST-adh/venv
    executable: stretch_ecm
resources:
  make_ecm:
    threads: 1
  equilibrate_ecm:
    threads: 1
  cellular_potts:
    threads: 1
  simulate_ecm:
    threads: 1
  state_dumper:
    threads: 1
  stretch_ecm:
    threads: 1
